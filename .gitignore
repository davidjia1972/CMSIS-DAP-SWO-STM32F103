#===============================================================================
# CMSIS-DAP_SWO  --  .gitignore
#
# 原则：凡是「能由源码重新生成」的产物一律忽略；凡是「重新生成不了」的
#      （上游随附的参考二进制、硬件网表、器件手册、实测日志）一律保留。
#===============================================================================

#-------------------------------------------------------------------------------
# 操作系统 / 编辑器产生的垃圾
#-------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

.vscode/
.idea/
*.swp
*.swo
*~
.cache/
.clangd/

#-------------------------------------------------------------------------------
# CMake + GCC 构建输出（cmake --build 可完全重建）
#-------------------------------------------------------------------------------
/build/
/build_gcc/
/build-*/
/cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
Makefile
*.cmake.stamp
.ninja_deps
.ninja_log
build.ninja
rules.ninja

#-------------------------------------------------------------------------------
# Keil MDK
#-------------------------------------------------------------------------------
# 每个用户各自的窗口布局/断点位置，文件名里还带着用户名，纯属个人状态
*.uvgui.*
*.uvguix.*

# Keil 工程及其配套说明文档。已从 git 历史中清除，不再随开源仓库分发：
#   - 依赖 Keil 商业授权，以及 MDK v4.7 时代的 legacy RL-ARM/RV31 目录
#   - uvproj 内含绝对 Windows 路径（C:\Keil_v5\...），不可移植
#   - 9 个 target 对应 9 种硬件，无法验证与维护
# 各 target 的宏组合已完整迁移为 CMakeLists.txt 里的 BOARD 选项。
# 文件仍保留在本地文件系统上，待手工删除。
*.uvproj
*.uvprojx
*.uvopt
*.uvoptx

# uVision 编辑器的临时备份文件，形如 DAP_config.h~RF26e9b0d4.TMP
*~RF*.TMP
*.TMP
*.bak
*.orig

# Keil 编译中间产物（重新编译即可再生）
*.crf
*.dep
*.lnp
*.lst
*.plg
*.iex
*.sct.bak
*.__i
*.build_log.htm
*.htm
Listings/
Objects/
RTE/_*/
DebugConfig/
JLinkLog.txt
JLinkSettings.ini

#-------------------------------------------------------------------------------
# 通用编译产物
#-------------------------------------------------------------------------------
*.o
*.obj
*.ko
*.d
*.su
*.gch
*.pch
*.a
*.la
*.lo
*.ilk
*.exp
*.map
*.dSYM/
*.idb
*.pdb

# 主机端可执行文件（不影响单片机固件的 .hex/.bin/.axf/.elf）
*.exe
*.out
*.app
*.dll
*.so
*.so.*
*.dylib

#-------------------------------------------------------------------------------
# 硬件设计
#-------------------------------------------------------------------------------
# 自制调试器的原理图/网表与器件手册。本仓库只开源软件部分，硬件设计不随之分发
# （其中的器件手册属厂商版权文档，本就不应转发）。已从 git 历史中清除；若日后
# 在本地重建该目录，此规则可防止误提交。
/hardware/

#-------------------------------------------------------------------------------
# 不可分发的第三方二进制
#-------------------------------------------------------------------------------
# Keil RL-USB 商业预编译库（ORC 格式）。已从 git 历史清除：无开源授权，不能随
# 仓库分发。两条构建路径都不需要它——CMake 用 third_party/USBStack/ 源码；Keil 工程引用的是
# 其安装目录下的 C:\Keil_v5\ARM\RV31\LIB\USB_CM3.lib，而非仓库里这份。
# 文件仍保留在本地文件系统上，待手工删除。
/src/usb/USB_CM3.lib

#-------------------------------------------------------------------------------
# 本地烧录/调试工作目录
#-------------------------------------------------------------------------------
# 固件快照、实测日志、自用脚本、第三方器件支持包等，属个人工作现场，不随开源
# 仓库分发。已从 git 历史中清除；若日后在本地重建，此规则可防止误提交。
/burn/

#===============================================================================
# 以下内容是「刻意保留」的，请勿随手加进忽略列表：
#
#   third_party/                 外部引入的代码，其中 USBStack/ 已就地修改，必须入库
#   docs/**                      引脚图、接线说明、Windows CDC 驱动、示例（含 .rar）
#
# 注意：排除具体文件时请写明确路径（如 /src/usb/USB_CM3.lib），不要用 *.lib 这类
#      通配规则——本仓库未来可能需要引入其他同类文件。
#===============================================================================
